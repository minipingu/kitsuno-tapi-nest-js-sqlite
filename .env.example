PORT=3000
NODE_ENV=development

# Database configuration
# Set DB_TYPE to 'sqlite' for zero-config local run, or 'postgres' for PostgreSQL
DB_TYPE=sqlite
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kitsuno

# If using Postgres with individual variables:
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=kitsuno

# Session Secret
SESSION_SECRET=kitsuno-nest-session-secret-key-2026

# Email Service (Resend)
RESEND_API_KEY=

# Jotoba API
JOTOBA_API_URL=https://jotoba.de/api
