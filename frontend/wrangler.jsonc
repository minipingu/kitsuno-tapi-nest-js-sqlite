{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kitsuno-frontend",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "@tanstack/react-start/server-entry",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  }
}