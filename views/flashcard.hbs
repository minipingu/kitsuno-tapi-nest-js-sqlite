<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Check your own flashcards | Kitsuno</title>

        <link rel="icon" href="/images/favicon/favicon-32x32.png" sizes="32x32" type="image/png">
        <link rel="icon" href="/images/favicon/favicon-64x64.png" sizes="64x64" type="image/png">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Kalam:wght@300;400;700&family=Poppins:ital,wght@0,100;0,400;0,500;0,600;1,400;1,500;1,600&family=Quicksand:wght@300..700&display=swap"
              rel="stylesheet">

        <link rel="stylesheet" href="https://cdn.lineicons.com/5.0/lineicons.css"/>
        <link rel="stylesheet" href="/css/styles.css">
    </head>
    <body>
        <nav class="navbar">
            <div class="logo">
                <a href="/">
                    <img src="/images/navbar/logo.png" alt="Logo">
                </a>
            </div>
            <ul class="nav-links">
                <li><a href="/vocabulary"><img src="/images/navbar/vocabulary_icon.png" alt="Vocabulary Icon">
                    <span>Vocabulary</span></a>
                </li>
                <li><a href="/hiragana"><img src="/images/navbar/hiragana_icon.png" alt="Hiragana Icon">
                    <span>Hiragana</span></a></li>
                <li><a href="/katakana"><img src="/images/navbar/katakana_icon.png" alt="Katakana Icon">
                    <span>Katakana</span></a></li>
                <li><a href="/kanji"><img src="/images/navbar/kanji_icon.png" alt="Kanji Icon"> <span>Kanji</span></a>
                </li>
                <li class="active"><a href="/flashcards"><img src="/images/navbar/flashcard_icon.png" alt="Flashcards Icon">
                    <span>Flashcards</span></a></li>
                <li><a href="/particles"><img src="/images/navbar/particle_icon.png" alt="Particle Icon">
                    <span>Particles</span></a></li>
            </ul>
            <div class="user-section">
                <a href="#" class="user-link">
                    {{#if user}}
                        <h6>Hi <span>{{user.username}}!</span></h6>
                    {{else}}
                        <h6>Hi Guest!</h6>
                    {{/if}}
                    <img src="/images/navbar/user_icon.png" alt="User Icon" class="user-icon">
                </a>
                <ul class="user-dropdown">
                    {{#if user}}
                        <li>
                            <a href="/profile"><img src="/images/navbar/profile.png" alt="Profile Icon"> Profile</a>
                        </li>
                        <li>
                            <a href="/logout"><img src="/images/navbar/logout.png" alt="Logout Icon"> Logout</a>
                        </li>
                    {{else}}
                        <li>
                            <a href="/login"><img src="/images/navbar/login.png" alt="Login Icon"> LogIn</a>
                        </li>
                        <li>
                            <a href="/register"><img src="/images/navbar/register.png" alt="Register Icon"> Register</a>
                        </li>
                    {{/if}}
                    <li>
                        <a href="/v1/api-docs"><img src="/images/navbar/api.png" alt="Api-Docs Icon"> ApiDocs</a>
                    </li>
                </ul>
            </div>
        </nav>

        <nav class="bottom-navbar">
            <ul class="nav-links">
                <li><a href="/vocabulary"><img src="/images/navbar/vocabulary_icon.png" alt="Vocabulary Icon">
                    <span>Vocabulary</span></a>
                </li>
                <li><a href="/hiragana"><img src="/images/navbar/hiragana_icon.png" alt="Hiragana Icon">
                    <span>Hiragana</span></a></li>
                <li><a href="/katakana"><img src="/images/navbar/katakana_icon.png" alt="Katakana Icon">
                    <span>Katakana</span></a></li>
                <li><a href="/kanji"><img src="/images/navbar/kanji_icon.png" alt="Kanji Icon"> <span>Kanji</span></a>
                </li>
                <li class="active"><a href="/flashcards"><img src="/images/navbar/flashcard_icon.png" alt="Flashcards Icon">
                    <span>Flashcards</span></a></li>
                <li><a href="/particles"><img src="/images/navbar/particle_icon.png" alt="Particle Icon">
                    <span>Particles</span></a></li>
            </ul>
        </nav>

        <div id="main-section">
            <h2 class="kana-h1">Flashcards</h2>

            {{#if user}}
            <div class="fc-wrapper">
                {{#if flashcardsList.length}}
                <div class="fc-top-controls">
                    <div class="fc-search-box">
                        <i class="lni lni-search-1"></i>
                        <input type="text" id="fcSearchInput" placeholder="Search by Kanji or Meaning..." />
                    </div>

                    <div class="fc-top-exports">
                        <div class="fc-export-buttons-group">
                            <form action="/flashcards/export_flashcards_csv" method="post">
                                <button type="submit" class="fc-export-btn" title="Export to CSV">
                                    <img src="/images/flashcards/csv.png" alt="CSV"> CSV
                                </button>
                            </form>
                            <form action="/flashcards/export_flashcards_anki" method="post">
                                <button type="submit" class="fc-export-btn" title="Export to Anki">
                                    <img src="/images/flashcards/anki.png" alt="Anki"> Anki
                                </button>
                            </form>
                            <form action="/flashcards/export_flashcards_json" method="post">
                                <button type="submit" class="fc-export-btn" title="Export to JSON">
                                    <img src="/images/flashcards/json.png" alt="JSON"> JSON
                                </button>
                            </form>
                        </div>

                        <!-- Shared Loading Status (Appears dynamically via JS) -->
                        <div class="fc-exporting-status">
                            <i class="lni lni-spinner-g fc-spinner"></i> Exporting flashcards...
                        </div>
                    </div>
                </div>

                <div class="fc-grid">
                    {{#each flashcardsList}}
                    <div class="fc-card"
                         data-kanji="{{this.kanji.character}}"
                         data-meaning="{{this.kanji.meanings}}"
                         data-grade="{{this.kanji.grade}}"
                         data-kunyomi="{{#if this.kanji.kunyomiReadings}}{{join this.kanji.kunyomiReadings ', '}}{{else}}-{{/if}}"
                         data-onyomi="{{#if this.kanji.onyomiReadings}}{{join this.kanji.onyomiReadings ', '}}{{else}}-{{/if}}"
                         data-notes="{{this.notes}}"
                         data-vocab="{{#if this.vocabulary}}{{join this.vocabulary '|||'}}{{/if}}"
                         role="button" tabindex="0">
                        <div class="fc-actions">
                            <a class="fc-btn fc-btn-edit" title="Edit"
                               href="/kanji/{{this.kanji.character}}">
                                <i class="lni lni-pencil-1"></i>
                            </a>
                            <form action="/flashcards/delete/{{this.id}}" method="post">
                                <button type="submit" class="fc-btn fc-btn-delete" title="Delete">
                                    <i class="lni lni-trash-3"></i>
                                </button>
                            </form>
                        </div>

                        <div class="fc-card-inner">
                            <div class="fc-face fc-front">
                                <div class="fc-kanji">{{this.kanji.character}}</div>
                                <span class="fc-hint">Click to view details</span>
                            </div>
                            <div class="fc-face fc-back">
                                <span class="fc-back-title">Notes</span>
                                <div class="fc-notes {{#unless this.notes}}fc-empty{{/unless}}">
                                    {{#if this.notes}}{{this.notes}}{{else}}No notes added.{{/if}}
                                </div>
                                <span class="fc-hint">Click to view details</span>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                <!-- SINGLE REUSABLE MODAL (NO CSS CHANGES) -->
                <div class="fc-overlay" id="fcSingleModal">
                    <div class="fc-modal">
                        <button type="button" class="fc-close" aria-label="Close">&times;</button>

                        <div class="fc-modal-head">
                            <div class="fc-modal-kanji" id="modalKanji"></div>
                            <div>
                                <h2 id="modalMeaning"></h2>
                                <span class="fc-badge" id="modalGrade"></span>
                            </div>
                        </div>

                        <div class="fc-section">
                            <h3>Readings</h3>
                            <div class="fc-readings">
                                <div class="fc-reading">
                                    <span class="fc-reading-label">Kunyomi</span>
                                    <span class="fc-reading-value" id="modalKunyomi"></span>
                                </div>
                                <div class="fc-reading">
                                    <span class="fc-reading-label">Onyomi</span>
                                    <span class="fc-reading-value" id="modalOnyomi"></span>
                                </div>
                            </div>
                        </div>

                        <div class="fc-section" id="modalVocabSection">
                            <h3>Vocabulary</h3>
                            <ul class="fc-vocab" id="modalVocabList"></ul>
                        </div>

                        <div class="fc-section" id="modalNotesSection">
                            <h3>Notes</h3>
                            <p class="fc-modal-notes" id="modalNotes"></p>
                        </div>
                    </div>
                </div>

                {{#unless flashcardsList.length}}
                <div class="info-div">
                    <p class="info">You can create custom flashcards by visiting the Kanji page, selecting a character, and clicking 'Create Flashcard'.</p>
                </div>
                {{/unless}}
            </div>
            {{else}}
            <div class="info-div">
                <p class="info">Please <a href="/login" style="color: #6366f1; text-decoration: underline;">log in</a> to view and create your custom flashcards.</p>
            </div>
            {{/if}}
        </div>

        <script src="/js/script.js"></script>
    </body>
</html>
